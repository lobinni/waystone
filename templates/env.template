# Copy this file to .env at the repository root, or export the values in your shell.
# `node scripts/keys.mjs` writes a filled .env for you and asks the network to fund the accounts.
# Never commit a filled .env. In a GitHub Codespace, store these names as Codespaces secrets instead.

# Required: three different accounts funded on Studionet.
# The organizer pays for transactions and never stakes: about 0.05 GEN is enough.
# Alice and Bob stake in the test pools and post contest bonds: about 0.1 GEN each.
ORGANIZER_KEY=0x
ALICE_KEY=0x
BOB_KEY=0x

# Optional: a third member. Without it a fresh account is funded through the simulator and the arena
# scenario is skipped when that is not possible.
CAROL_KEY=

# Optional: a referee and an outsider. Random accounts are used when these are empty; the referee is
# funded through the simulator when it holds nothing, the outsider only ever sends unpaid calls.
REFEREE_KEY=
OUTSIDER_KEY=

# Optional: run against an existing deployment instead of deploying contracts/waystone.py first.
# Leave empty to use the address recorded in deployment.json.
WAYSTONE_ADDRESS=

# Optional: where the reports are written.
# REPORT_DIR=reports

# Optional: a private key used only by scripts/deploy.mjs. Falls back to ORGANIZER_KEY.
# DEPLOY_KEY=0x
